# Copy to frontend/.env.local for development, or set in Vercel before building.
# Only public browser configuration belongs here. Never add Gemini/private keys.
VITE_API_BASE=http://127.0.0.1:8000
VITE_CLOUD_ENABLED=true
VITE_CLERK_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# For guest-only local work, explicitly use VITE_CLOUD_ENABLED=false.
# Split hosting requires VITE_API_BASE to be your actual HTTPS Render URL.
