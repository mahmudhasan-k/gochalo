# Backend local development: copy this file to .env. Never commit actual keys.
# Production ignores .env: enter backend values directly in Render.
GEMINI_API_KEY=
GEMINI_BACKUP_API_KEY_1=
GEMINI_BACKUP_API_KEY_2=
# Up to two independent server-only backup keys; not a comma-separated list.
# Same-project Gemini keys share provider quota. See docs/CONFIGURATION.md.
GEMINI_MODEL=gemini-3.5-flash-lite
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DETERMINISTIC_REVIEW_FALLBACK=true
LOCAL_EVALUATION_CAPTURE=false
# Experimental research is opt-in; General Ask remains the main search input.
RESEARCH_FREE_ACCESS_CONFIRMED=false
GEMINI_RESEARCH_MODEL=gemini-2.5-flash
# Optional secondary source-analysis route; leave unset unless explicitly needed.
GEMINI_FALLBACK_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Platform/container settings (not credentials). Render supplies PORT itself.
# PORT=8000
# PYTHONUNBUFFERED=1
# PYTHONDONTWRITEBYTECODE=1
# Frontend BUILD settings: put these in frontend/.env.local or Vercel, not just .env.
# VITE_API_BASE=https://YOUR-RENDER-SERVICE.onrender.com
# VITE_CLOUD_ENABLED=true
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_PUBLIC_KEY
# VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_PUBLIC_KEY
# No Jina/OCR key, Clerk secret or Supabase service-role/JWT secret is used by this app.
